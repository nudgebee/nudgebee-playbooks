#!/usr/bin/env bash
# nb — call one Nudgebee API action.
#
#   nb <action> ['<params json>']        params default to {}
#   nb <action> @file.json               params read from a file
#
# Env: NB_API_TOKEN (required), NB_URL (default https://app.nudgebee.com).
# Prints the JSON response. Exits non-zero on HTTP errors.
set -euo pipefail

if [[ $# -lt 1 || "$1" == "-h" || "$1" == "--help" ]]; then
  sed -n '2,8p' "$0" | sed 's/^# \{0,1\}//'
  exit 2
fi
: "${NB_API_TOKEN:?set NB_API_TOKEN to your Nudgebee API token}"
url="${NB_URL:-https://app.nudgebee.com}"
url="${url%/}/api/rpc"

action="$1"
params="${2:-}"
if [[ -z "$params" ]]; then
  params='{}'
elif [[ "$params" == @* ]]; then
  params="$(cat "${params#@}")"
fi
if [[ ! "$action" =~ ^[a-z0-9_]+$ ]]; then
  echo "nb: action must be lowercase letters, digits and underscores" >&2
  exit 2
fi

body="{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"$action\",\"params\":$params}"
resp="$(mktemp)"
trap 'rm -f "$resp"' EXIT
code="$(curl -sS -o "$resp" -w '%{http_code}' "$url" \
  -H 'content-type: application/json' \
  -H "Authorization: Bearer $NB_API_TOKEN" \
  --data-binary @- <<<"$body")"
cat "$resp"
echo
if [[ "$code" -ge 400 ]]; then
  echo "nb: HTTP $code from $action" >&2
  exit 1
fi
